{
  "title": "PostClient",
  "type": "object",
  "properties": {
    "cnpj": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9]{12}[0-9]{2}|[A-Za-z0-9]{2}\\.[A-Za-z0-9]{3}\\.[A-Za-z0-9]{3}/[A-Za-z0-9]{4}-[0-9]{2})$"
    },
    "legal_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "trade_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "client_type": {
      "type": "string",
      "enum": ["MEI", "PJ"]
    },
    "cnpj_status": {
      "type": "string",
      "enum": ["ACTIVE", "SUSPENDED", "INAPT", "CLOSED", "NULL"]
    },
    "primary_activity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "monthly_revenue_cents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000000000
    },
    "email": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "phone_number": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{7,14}$"
    },
    "address": {
      "type": "object",
      "properties": {
        "street": {"type": "string", "minLength": 1, "maxLength": 255},
        "number": {"type": "string", "minLength": 1, "maxLength": 30},
        "complement": {"type": "string", "maxLength": 100},
        "neighborhood": {"type": "string", "minLength": 1, "maxLength": 100},
        "city": {"type": "string", "minLength": 1, "maxLength": 100},
        "state": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "postal_code": {"type": "string", "pattern": "^[0-9]{8}$"},
        "country": {"type": "string", "pattern": "^[A-Z]{2}$"}
      },
      "required": ["street", "number", "neighborhood", "city", "state", "postal_code", "country"],
      "additionalProperties": false
    },
    "legal_representative": {
      "type": "object",
      "properties": {
        "cpf": {
          "type": "string",
          "pattern": "^(?:[0-9]{11}|[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2})$"
        },
        "full_name": {"type": "string", "minLength": 1, "maxLength": 255},
        "birthdate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "email": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "phone_number": {"type": "string", "pattern": "^\\+[1-9][0-9]{7,14}$"},
        "role": {"type": "string", "minLength": 1, "maxLength": 100},
        "password": {"type": "string", "minLength": 8, "maxLength": 128}
      },
      "required": ["cpf", "full_name", "birthdate", "email", "phone_number", "role", "password"],
      "additionalProperties": false
    }
  },
  "required": [
    "cnpj",
    "legal_name",
    "client_type",
    "cnpj_status",
    "primary_activity",
    "monthly_revenue_cents",
    "email",
    "phone_number",
    "address",
    "legal_representative"
  ],
  "additionalProperties": false
}
