{
  "title": "PostClient",
  "type": "object",
  "properties": {
    "person_type": {
      "enum": [
        "PF",
        "PJ"
      ]
    }
  },
  "required": [
    "person_type"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "person_type": {
            "const": "PF"
          }
        },
        "required": [
          "person_type"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "person_type": {
            "const": "PF"
          },
          "document_number": {
            "type": "string",
            "pattern": "^(?:[0-9]{11}|[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2})$"
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
          },
          "phone_number": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{7,14}$"
          },
          "address": {
            "$ref": "client_address.json"
          },
          "monthly_income_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000000
          },
          "full_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "birthdate": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "person_type",
          "document_number",
          "email",
          "phone_number",
          "address",
          "monthly_income_cents",
          "full_name",
          "birthdate",
          "password"
        ],
        "additionalProperties": false
      }
    },
    {
      "if": {
        "properties": {
          "person_type": {
            "const": "PJ"
          }
        },
        "required": [
          "person_type"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "person_type": {
            "const": "PJ"
          },
          "document_number": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9]{12}[0-9]{2}|[A-Za-z0-9]{2}\\.[A-Za-z0-9]{3}\\.[A-Za-z0-9]{3}/[A-Za-z0-9]{4}-[0-9]{2})$"
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
          },
          "phone_number": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{7,14}$"
          },
          "address": {
            "$ref": "client_address.json"
          },
          "monthly_income_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000000
          },
          "legal_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "trade_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "primary_activity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "legal_representative": {
            "type": "object",
            "properties": {
              "cpf": {
                "type": "string",
                "pattern": "^(?:[0-9]{11}|[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2})$"
              },
              "full_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "birthdate": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "email": {
                "type": "string",
                "maxLength": 255,
                "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
              },
              "phone_number": {
                "type": "string",
                "pattern": "^\\+[1-9][0-9]{7,14}$"
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "password": {
                "type": "string",
                "minLength": 8,
                "maxLength": 128
              }
            },
            "required": [
              "cpf",
              "full_name",
              "birthdate",
              "email",
              "phone_number",
              "role",
              "password"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "person_type",
          "document_number",
          "email",
          "phone_number",
          "address",
          "monthly_income_cents",
          "legal_name",
          "primary_activity",
          "legal_representative"
        ],
        "additionalProperties": false
      }
    }
  ]
}
